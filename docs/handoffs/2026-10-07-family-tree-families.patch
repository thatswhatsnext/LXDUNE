+# The Family Tree's families: models that share an idea about how learning works.
+# Groupings approved by Steve Grant on 2026-10-04 (Field Guide redesign handoff, open question 1).
+# v1.0.0 summaries reviewed and signed off by Steve Grant on 2026-10-07, who also confirmed the 5E/7E
+# lineage claim, Ambitious Science Teaching's placement, and that the Family Tree opens on families.
+# Every model in the reckoner sits in exactly one family; validate checks this.
+# Models are listed in the order the Family Tree shows them.
+schemaVersion: '1.0'
+id: families
+version: 1.0.0
+status: published
+lastReviewed: '2026-10-07'
+provenance:
+  source: ai-drafted-reviewed
+  authors: ['Claude, drafted for S. Grant']
+  reviewedBy: ['Steve Grant']
+  reviewedOn: '2026-10-07'
+
+families:
+  - id: learning-cycles
+    name: Learning cycles
+    summary: 'Experience comes first, then the term, then using it. 5E and 7E grew out of the original Learning cycle.'
+    models: [learning-cycle, 5e, 7e]
+
+  - id: conceptual-change
+    name: Conceptual change
+    summary: 'Start from what students already think, test it against evidence, and give them good reason to change their minds.'
+    models: [glm, interactive-approach, poe]
+
+  - id: argument-and-writing
+    name: Argument and writing
+    summary: 'Students build claims from evidence and sharpen them by arguing, writing and reviewing each other’s work.'
+    models: [swh, adi]
+
+  - id: reasoning
+    name: Reasoning
+    summary: 'Lessons designed to stretch how students reason, not only what they know.'
+    models: [case]
+
+  - id: problems-projects-issues
+    name: Problems, projects and issues
+    summary: 'Learning organised around a problem to solve, a product to make or an issue to decide, where science is the means.'
+    models: [pbl, project-based, design-cycle, ssi, ast]
+
+  - id: across
+    name: Across every branch
+    summary: 'Not a family of its own. Levels of inquiry sets how much you specify, inside any model above.'
+    models: [levels-of-inquiry]
+    across: true
